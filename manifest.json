{
  "manifest_version": 3,
  "name": "共用标点字体替换",
  "version": "1.0.2",
  "description": "为共用标点指定字形，将常见中文正文字体替换为苹方 UI，保留其他字体列表。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "fontSettings", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "共用标点字体替换设置" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["main-runtime.js"], "run_at": "document_start", "all_frames": true, "match_origin_as_fallback": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["shared.js", "bridge.js"], "run_at": "document_start", "all_frames": true, "match_origin_as_fallback": true }
  ]
}
